CREATE SCHEMA IF NOT EXISTS billing;

CREATE TABLE billing.wallet (
    id         BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    owner_id   BIGINT      NOT NULL,
    balance    BIGINT      NOT NULL DEFAULT 0, -- minor units
    currency   CHAR(3)     NOT NULL,
    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    CONSTRAINT uq_wallet_owner_id_currency UNIQUE (owner_id, currency),
    CONSTRAINT ck_wallet_balance_non_negative CHECK (balance >= 0)
);

CREATE TABLE billing.transfer (
    id             BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    initiator_id   BIGINT      NOT NULL,
    from_wallet_id BIGINT      NOT NULL,
    to_wallet_id   BIGINT      NOT NULL,
    amount         BIGINT      NOT NULL, -- minor units
    currency       CHAR(3)     NOT NULL,
    status         VARCHAR(32) NOT NULL,
    created_at     TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    updated_at     TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    CONSTRAINT fk_transfer_from_wallet_id FOREIGN KEY (from_wallet_id) REFERENCES billing.wallet (id) ON DELETE RESTRICT,
    CONSTRAINT fk_transfer_to_wallet_id FOREIGN KEY (to_wallet_id) REFERENCES billing.wallet (id) ON DELETE RESTRICT,
    CONSTRAINT ck_transfer_amount_positive CHECK (amount > 0),
    CONSTRAINT ck_transfer_status CHECK (status IN ('COMPLETED', 'REVERSED'))
);

CREATE INDEX idx_transfer_from_wallet_id ON billing.transfer (from_wallet_id);
CREATE INDEX idx_transfer_to_wallet_id ON billing.transfer (to_wallet_id);
CREATE INDEX idx_transfer_initiator_id_status ON billing.transfer (initiator_id, status);
