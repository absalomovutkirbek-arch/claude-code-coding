{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(php -l *)",
      "Bash(php yii help *)",
      "Bash(php yii migrate/create *)",
      "Bash(php yii migrate/history *)",
      "Bash(php yii migrate/new *)",
      "Bash(composer validate *)",
      "Bash(composer dump-autoload *)",
      "Bash(composer show *)",
      "Bash(vendor/bin/codecept run *)",
      "Bash(vendor/bin/codecept build *)",
      "Bash(vendor/bin/phpunit *)",
      "Bash(vendor/bin/phpstan *)",
      "Bash(vendor/bin/php-cs-fixer fix *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git ls-files *)"
    ],
    "ask": [
      "Bash(php yii migrate *)",
      "Bash(php yii migrate/up *)",
      "Bash(php yii migrate/down *)",
      "Bash(php yii migrate/redo *)",
      "Bash(php yii migrate/to *)",
      "Bash(composer require *)",
      "Bash(composer update *)",
      "Bash(composer remove *)",
      "Bash(git commit *)",
      "Bash(git push *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Edit(vendor/**)",
      "Bash(php yii migrate/fresh *)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "php \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-files.php\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "php \"${CLAUDE_PROJECT_DIR}/.claude/hooks/check-php.php\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
